{
  "name": "prepwise-meal-prep",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build-app.js",
    "native:add": "npm run build && cap add android && cap add ios",
    "native:sync": "npm run build && cap sync",
    "native:assets": "capacitor-assets generate --ios --android",
    "release:check": "node scripts/check-native-release.js",
    "smoke:production": "node scripts/smoke-production.js",
    "store:android-assets": "node scripts/generate-android-store-assets.js",
    "check": "node --check server.js && node --check client.js && node --check subscription.js && node --check native-store.js && node --check app-store-notifications.js && node --check scripts/build-web.js && node --check scripts/generate-android-store-assets.js && node --check scripts/check-native-release.js && node --check scripts/smoke-production.js",
    "typecheck": "tsc -p convex/tsconfig.json --noEmit",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@convex-dev/auth": "^0.0.94",
    "@sentry/browser": "^10.57.0",
    "@sentry/node": "^10.57.0",
    "convex": "^1.41.0",
    "esbuild": "^0.28.0",
    "posthog-js": "^1.386.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@types/node": "^24.13.2"
  }
}

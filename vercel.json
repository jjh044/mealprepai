{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "client.js",
      "use": "@vercel/static"
    },
    {
      "src": "subscription.js",
      "use": "@vercel/static"
    },
    {
      "src": "native-store.js",
      "use": "@vercel/static"
    },
    {
      "src": "privacy.html",
      "use": "@vercel/static"
    },
    {
      "src": "terms.html",
      "use": "@vercel/static"
    },
    {
      "src": "support.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/[...path].js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].js"
    },
    {
      "src": "/styles.css",
      "dest": "/styles.css"
    },
    {
      "src": "/client.js",
      "dest": "/client.js"
    },
    {
      "src": "/subscription.js",
      "dest": "/subscription.js"
    },
    {
      "src": "/native-store.js",
      "dest": "/native-store.js"
    },
    {
      "src": "/privacy.html",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms.html",
      "dest": "/terms.html"
    },
    {
      "src": "/support.html",
      "dest": "/support.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
